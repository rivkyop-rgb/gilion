// Gilion — Prisma schema
//
// Conventions binding for every model (docs/plan/00-foundation.md):
//   - id is String @id @default(cuid())
//   - every model carries created_at / updated_at
//   - @@map gives the table the PascalCase name used in docs/erd.md
//   - every ERD enum becomes a Prisma enum
//
// The connection URL lives in prisma.config.ts: Prisma 7 removed `url` from
// the datasource block in favour of a driver adapter.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Stage 01 — auth, tenancy, audit
// ---------------------------------------------------------------------------

enum CustomerType {
  regular
  casual
}

enum UserType {
  internal
  customer
}

enum MembershipRole {
  admin
  sales
  designer
  accounting
  customer
}

enum MembershipStatus {
  active
  inactive
}

/// The seven auditable actions from docs/erd.md. The enum is closed on
/// purpose: adding an action is a deliberate schema change, not a string typo.
enum AuditAction {
  approve_order
  reject_order
  delete_order
  cancel_publication
  close_issue
  generate_pdf
  update_payment
  override_duplicate_placement
}

/// An independent business in the multi-tenant system (FR-1, FR-2).
model Business {
  id         String   @id @default(cuid())
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  memberships  UserMembership[]
  audit_logs   AuditLog[]
  customers    Customer[]
  newspapers   Newspaper[]
  ad_orders    AdOrder[]
  publications Publication[]

  @@map("Business")
}

/// Internal user or customer-portal user (FR-2, FR-8, FR-9, US-009).
/// password_hash is not in the ERD but is required for credentials auth.
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password_hash String
  user_type     UserType
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  memberships UserMembership[]
  audit_logs  AuditLog[]

  @@map("User")
}

/// Binds a user to a business with one fixed role (FR-2, FR-8, FR-9).
model UserMembership {
  id          String           @id @default(cuid())
  user_id     String
  business_id String
  /// Required when role = customer, forbidden otherwise. Enforced by a CHECK
  /// constraint in the migration as well as in the domain layer.
  customer_id String?
  role        MembershipRole
  status      MembershipStatus @default(active)
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  business Business @relation(fields: [business_id], references: [id], onDelete: Restrict)

  @@unique([user_id, business_id])
  @@index([business_id, status])
  @@map("UserMembership")
}

/// Append-only audit trail (FR-10). There is no update or delete path:
/// lib/data/audit.ts exposes writes only.
model AuditLog {
  id          String      @id @default(cuid())
  business_id String
  user_id     String
  action      AuditAction
  target_type String
  target_id   String
  /// Only the fields that changed, not the whole record (conventions.md §6).
  old_value   Json?
  new_value   Json?
  created_at  DateTime    @default(now())

  business Business @relation(fields: [business_id], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([business_id, created_at(sort: Desc)])
  @@index([target_type, target_id])
  @@map("AuditLog")
}

// ---------------------------------------------------------------------------
// Stage 02 — customers
// ---------------------------------------------------------------------------

/// A regular or one-off advertiser (US-002).
///
/// Deliberately has no company registration number: that field appeared in the
/// Stitch mockups but is not in the ERD (docs/design/gaps.md §א).
model Customer {
  id            String       @id @default(cuid())
  business_id   String
  customer_type CustomerType
  /// Required for `regular`, optional for `casual` — enforced in the domain layer.
  business_name String?
  contact_name  String
  /// At least one of phone/email is required, enforced by a CHECK constraint.
  phone         String?
  email         String?
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  business     Business      @relation(fields: [business_id], references: [id], onDelete: Restrict)
  ad_orders    AdOrder[]
  publications Publication[]

  @@index([business_id, contact_name])
  @@index([business_id, business_name])
  @@index([business_id, customer_type])
  @@map("Customer")
}

// ---------------------------------------------------------------------------
// Stage 03 — newspaper configuration, page grid, ad shapes and pricing
// ---------------------------------------------------------------------------

/// Where on the page a shape may sit (US-006 AC-4).
enum OrderSource {
  internal
  customer_portal
}

enum OrderStatus {
  draft
  pending_approval
  approved
  rejected
  canceled
  completed
}

enum PaymentStatus {
  unpaid
  partially_paid
  paid
  debt
}

/// The eight publication states from conventions.md §3.
enum PublicationStatus {
  planned
  missing_ad
  ad_received
  ready_for_layout
  placed
  published
  canceled
  billed
}

/// Derived field: `placed` exactly while an active Placement exists.
enum PlacementStatus {
  not_placed
  placed
}

enum ShapePosition {
  anywhere
  region
}

/// A newspaper published by a business (US-006, FR-21).
model Newspaper {
  id               String   @id @default(cuid())
  business_id      String
  name             String
  /// One of the sizes in lib/domain/page-size.ts, or "custom".
  page_size        String
  /// Millimetres. Free-form print quality text, per the ERD — deliberately not
  /// a dpi picker: dpi/CMYK/bleed were Stitch inventions (design/gaps.md §א).
  margin           Decimal  @db.Decimal(6, 2)
  print_quality    String
  logo_url         String?
  fixed_banner_url String?
  /// Bytes. The single source of truth for the upload limit (FR-21) — there is
  /// no hard-coded size anywhere in the code.
  max_ad_file_size Int
  /// Only set when page_size = "custom". Millimetres.
  custom_width_mm  Decimal? @db.Decimal(7, 2)
  custom_height_mm Decimal? @db.Decimal(7, 2)

  /// --- Page grid (US-006 AC-4) ---------------------------------------------
  /// The page is divided into `columns` columns of derived width and rows of
  /// `row_height_mm`. The ROW COUNT AND COLUMN WIDTH ARE NEVER STORED: they are
  /// derived from the page size in lib/domain/grid.ts, so changing page_size or
  /// margin can never leave a stale, contradictory number in the database.
  columns       Int
  /// Millimetres, one grid row.
  row_height_mm Decimal @db.Decimal(6, 2)
  /// Millimetres. Applied between adjacent cells AND between the outermost
  /// cells and the frame, so it appears (columns + 1) times across the width.
  gutter_mm     Decimal @default(0) @db.Decimal(6, 2)

  /// --- Print schedule -------------------------------------------------------
  /// Which weekdays this newspaper is printed on, as JS `getDay()` numbers
  /// (0 = Sunday … 6 = Saturday). An EMPTY ARRAY means "no schedule declared",
  /// which is not the same as "never prints": with no schedule the order
  /// builder simply has nothing to check a date against and stays quiet.
  /// Deliberately a weekday list and not a rule engine — an irregular run
  /// (every other week, holiday eves only) is expressed by the dates the user
  /// ticks on the order, not by a recurrence stored here.
  publication_days Int[] @default([])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  business     Business      @relation(fields: [business_id], references: [id], onDelete: Restrict)
  page_types   PageType[]
  ad_shapes    AdShape[]
  price_rules  PriceRule[]
  order_items  AdOrderItem[]
  publications Publication[]

  @@unique([business_id, name])
  @@index([business_id])
  @@map("Newspaper")
}

/// Cover, back, inner, premium… free text, not an enum (US-006).
model PageType {
  id           String   @id @default(cuid())
  newspaper_id String
  name         String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  newspaper      Newspaper        @relation(fields: [newspaper_id], references: [id], onDelete: Cascade)
  allowed_shapes AllowedAdShape[]
  price_rules    PriceRule[]
  order_items    AdOrderItem[]

  @@unique([newspaper_id, name])
  /// Target for the composite foreign keys below. `id` alone is already unique;
  /// this pair exists so a child row must name the newspaper it belongs to.
  @@unique([id, newspaper_id])
  @@index([newspaper_id])
  @@map("PageType")
}

/// A rectangular ad shape, measured in GRID UNITS of its newspaper's page
/// division (US-006 AC-4).
///
/// Owned by the newspaper: the six base shapes in lib/domain/base-shapes.ts are
/// copied in when a newspaper is created, and the newspaper edits, deletes and
/// adds to them freely. Until 24/08/2026 this model was global — the one
/// documented exception to tenant scoping — and the reversal is recorded in
/// conventions.md §2. Tying the shape to the newspaper is what makes `cols` and
/// `rows` meaningful: they are only ever read against one grid.
model AdShape {
  id            String        @id @default(cuid())
  newspaper_id  String
  name          String
  /// Footprint in grid cells. Rectangular only — no L-shapes in the MVP.
  cols          Int
  rows          Int
  position_mode ShapePosition @default(anywhere)
  /// null when position_mode = anywhere. Otherwise { cells: [[col, row], …] }:
  /// the set that every cell of the shape's footprint must fall inside.
  allowed_cells Json?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  newspaper    Newspaper        @relation(fields: [newspaper_id], references: [id], onDelete: Cascade)
  allowed_on   AllowedAdShape[]
  price_rules  PriceRule[]
  order_items  AdOrderItem[]
  publications Publication[]

  @@unique([newspaper_id, name])
  /// Target for the composite foreign keys below — see PageType.
  @@unique([id, newspaper_id])
  @@index([newspaper_id])
  @@map("AdShape")
}

/// Which shapes may be placed on a given page type (FR-14).
///
/// Both foreign keys carry `newspaper_id`, so a row pairing one newspaper's
/// page type with another's shape is not merely rejected — it cannot be
/// represented. Tenant safety here does not depend on anyone remembering
/// (conventions.md §2).
model AllowedAdShape {
  id           String   @id @default(cuid())
  newspaper_id String
  page_type_id String
  ad_shape_id  String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  page_type PageType @relation(fields: [page_type_id, newspaper_id], references: [id, newspaper_id], onDelete: Cascade)
  /// Cascade, not Restrict: the Restrict existed to protect TemplateSlot, which
  /// is gone, and the shapes now belong to the user. Deleting a shape takes its
  /// permissions with it.
  ad_shape  AdShape  @relation(fields: [ad_shape_id, newspaper_id], references: [id, newspaper_id], onDelete: Cascade)

  @@unique([page_type_id, ad_shape_id])
  @@index([newspaper_id])
  @@map("AllowedAdShape")
}

/// Base price per (newspaper, page type, shape). Copied onto the publication at
/// order approval and never read again — conventions.md §7, FR-17.
model PriceRule {
  id           String   @id @default(cuid())
  newspaper_id String
  page_type_id String
  ad_shape_id  String
  price        Decimal  @db.Decimal(12, 2)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  newspaper Newspaper @relation(fields: [newspaper_id], references: [id], onDelete: Cascade)
  page_type PageType  @relation(fields: [page_type_id, newspaper_id], references: [id, newspaper_id], onDelete: Cascade)
  /// Cascade is safe here precisely because of conventions.md §7 rule 1: a
  /// PriceRule is only ever a default at order-creation time and
  /// Publication.price is a copy, so deleting a shape cannot rewrite money that
  /// has already been agreed.
  ad_shape  AdShape   @relation(fields: [ad_shape_id, newspaper_id], references: [id, newspaper_id], onDelete: Cascade)

  @@unique([newspaper_id, page_type_id, ad_shape_id])
  @@index([newspaper_id])
  @@map("PriceRule")
}

// ---------------------------------------------------------------------------
// Stage 04 — orders and publications
// ---------------------------------------------------------------------------

/// A sales order. Nothing binding exists until it is approved: a draft creates
/// no publications at all (US-003 AC-5).
model AdOrder {
  id                      String        @id @default(cuid())
  business_id             String
  customer_id             String
  source                  OrderSource   @default(internal)
  status                  OrderStatus   @default(draft)
  /// Optional (FR-19). When present it is shown to the customer in the portal.
  rejection_reason        String?
  /// Sum of the line prices. Computed on the server only, never trusted from
  /// the client. A single total — no VAT and no commissions, which were Stitch
  /// inventions (docs/design/gaps.md §א).
  total_price             Decimal       @default(0) @db.Decimal(12, 2)
  payment_status          PaymentStatus @default(unpaid)
  external_invoice_number String?
  approved_at             DateTime?
  completed_at            DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  business     Business      @relation(fields: [business_id], references: [id], onDelete: Restrict)
  customer     Customer      @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  items        AdOrderItem[]
  publications Publication[]

  @@index([business_id, status])
  @@index([business_id, customer_id, created_at])
  @@map("AdOrder")
}

/// One planned publication inside an order.
///
/// `page_type_id` is not in the ERD but is required: PriceRule is keyed by
/// (newspaper, page_type, ad_shape), so without it no price can be derived.
/// Documented as an implementation addition in docs/plan/04-orders-publications.md.
model AdOrderItem {
  id               String   @id @default(cuid())
  order_id         String
  newspaper_id     String
  page_type_id     String
  ad_shape_id      String
  publication_date DateTime @db.Date
  /// Taken from PriceRule as a default, overridable by hand. Once the order is
  /// approved this value is copied onto the Publication and frozen (FR-17).
  price            Decimal  @db.Decimal(12, 2)
  /// Set when the user knowingly ordered a date that is not one of the
  /// newspaper's `publication_days` — a special edition. Stored rather than
  /// re-derived so that later changing the newspaper's schedule cannot
  /// retroactively turn a deliberate choice into a warning.
  off_schedule     Boolean  @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  order       AdOrder      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  newspaper   Newspaper    @relation(fields: [newspaper_id], references: [id], onDelete: Restrict)
  /// Composite keys, per conventions.md §2: a row that crosses one newspaper's
  /// page type with another newspaper's shape is not representable.
  page_type   PageType     @relation(fields: [page_type_id, newspaper_id], references: [id, newspaper_id], onDelete: Restrict)
  ad_shape    AdShape      @relation(fields: [ad_shape_id, newspaper_id], references: [id, newspaper_id], onDelete: Restrict)
  publication Publication?

  @@index([order_id])
  @@map("AdOrderItem")
}

/// A binding publication. Created only on order approval, one per order item.
model Publication {
  id               String            @id @default(cuid())
  business_id      String
  order_id         String
  /// Unique: this is what makes approval idempotent — a double click cannot
  /// produce duplicate publications.
  order_item_id    String?           @unique
  customer_id      String
  newspaper_id     String
  ad_shape_id      String
  advertisement_id String?
  publication_date DateTime          @db.Date
  /// Copied from AdOrderItem at approval and never read from PriceRule again
  /// (FR-17, conventions.md §7).
  price            Decimal           @db.Decimal(12, 2)
  source           OrderSource
  status           PublicationStatus @default(planned)
  placement_status PlacementStatus   @default(not_placed)
  payment_status   PaymentStatus     @default(unpaid)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  business   Business     @relation(fields: [business_id], references: [id], onDelete: Restrict)
  order      AdOrder      @relation(fields: [order_id], references: [id], onDelete: Restrict)
  order_item AdOrderItem? @relation(fields: [order_item_id], references: [id], onDelete: SetNull)
  customer   Customer     @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  newspaper  Newspaper    @relation(fields: [newspaper_id], references: [id], onDelete: Restrict)
  ad_shape   AdShape      @relation(fields: [ad_shape_id, newspaper_id], references: [id, newspaper_id], onDelete: Restrict)

  @@index([business_id, publication_date, status])
  @@index([business_id, newspaper_id, publication_date])
  @@index([business_id, customer_id])
  @@index([advertisement_id])
  @@map("Publication")
}
