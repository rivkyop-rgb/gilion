// Gilion — Prisma schema
//
// Conventions binding for every model (docs/plan/00-foundation.md):
//   - id is String @id @default(cuid())
//   - every model carries created_at / updated_at
//   - @@map gives the table the PascalCase name used in docs/erd.md
//   - every ERD enum becomes a Prisma enum
//
// The connection URL lives in prisma.config.ts: Prisma 7 removed `url` from
// the datasource block in favour of a driver adapter.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Stage 01 — auth, tenancy, audit
// ---------------------------------------------------------------------------

enum CustomerType {
  regular
  casual
}

enum UserType {
  internal
  customer
}

enum MembershipRole {
  admin
  sales
  designer
  accounting
  customer
}

enum MembershipStatus {
  active
  inactive
}

/// none = no access at all · read = may view · write = may view and change.
/// Mirrors the Access union in lib/auth/rbac.ts.
enum PermissionAccess {
  none
  read
  write
}

/// Whether a business may be worked in at all. Deactivation is reversible and
/// destroys nothing — it closes the door, it does not empty the room.
enum BusinessStatus {
  active
  inactive
}

/// The seven auditable actions from docs/erd.md. The enum is closed on
/// purpose: adding an action is a deliberate schema change, not a string typo.
enum AuditAction {
  approve_order
  reject_order
  delete_order
  deactivate_business
  activate_business
  update_role_permissions
  delete_customer
  cancel_publication
  close_issue
  generate_pdf
  update_payment
  override_duplicate_placement
}

/// An independent business in the multi-tenant system (FR-1, FR-2).
model Business {
  id     String         @id @default(cuid())
  name   String
  /// An inactive business cannot be entered by anyone, its own admin and a
  /// super admin included. Every row it owns stays exactly where it is, so
  /// reactivating restores the business whole — that is the difference between
  /// this and deleting, and the reason deletion is not offered at all.
  status BusinessStatus @default(active)

  /// How many days before its publication date a publication with no artwork
  /// starts appearing on the reminder list (FR-11).
  ///
  /// A setting and not a constant, because the right number is a property of
  /// how this particular publisher works — a weekly with a Tuesday deadline
  /// and a monthly catalogue do not chase customers on the same schedule.
  /// Admin edits it in settings; the default is a week.
  reminder_days_before Int @default(7)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  memberships    UserMembership[]
  audit_logs     AuditLog[]
  permissions    RolePermission[]
  customers      Customer[]
  newspapers     Newspaper[]
  ad_orders      AdOrder[]
  publications   Publication[]
  advertisements Advertisement[]
  issues         Issue[]

  @@map("Business")
}

/// Internal user or customer-portal user (FR-2, FR-8, FR-9, US-009).
/// password_hash is not in the ERD but is required for credentials auth.
/// A business's override of one cell in the permission matrix (FR-8).
///
/// ONLY overrides are stored. An absent row means "whatever the built-in
/// matrix says", so the defaults stay in code where TypeScript can keep every
/// role and area accounted for, and the database carries just the deltas. That
/// also means a business created today automatically picks up any future
/// change to a default it never touched.
///
/// FR-8 fixes the five roles themselves; prd.md §181 excludes CREATING or
/// duplicating roles from the MVP. Adjusting what a fixed role may reach is a
/// different thing, and FR-8 calls the designer's lack of payment access a
/// default — which is what this table lets a business change.
model RolePermission {
  id          String           @id @default(cuid())
  business_id String
  /// One of MembershipRole. `customer` is refused by the domain layer: the
  /// portal boundary is FR-9 and is not a business's to move.
  role        MembershipRole
  /// One of the Area union in lib/auth/rbac.ts.
  area        String
  access      PermissionAccess

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@unique([business_id, role, area])
  @@index([business_id])
  @@map("RolePermission")
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password_hash  String
  user_type      UserType
  /// Platform owner. Deliberately a property of the PERSON and not a sixth
  /// MembershipRole: the five roles describe what someone may do INSIDE one
  /// business, and this describes someone who stands above all of them. As a
  /// membership it would have needed a business to belong to, which is exactly
  /// what it does not have.
  ///
  /// Inside an active business a super admin acts as `admin`, so the whole
  /// permission matrix keeps working untouched. What the flag adds is the
  /// right to enter ANY business without a membership, and to reach the
  /// platform area where businesses themselves are created.
  is_super_admin Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  memberships         UserMembership[]
  audit_logs          AuditLog[]
  advertisements      Advertisement[]
  duplicate_overrides Placement[]

  @@map("User")
}

/// Binds a user to a business with one fixed role (FR-2, FR-8, FR-9).
model UserMembership {
  id          String           @id @default(cuid())
  user_id     String
  business_id String
  /// Required when role = customer, forbidden otherwise. Enforced by a CHECK
  /// constraint in the migration as well as in the domain layer.
  customer_id String?
  role        MembershipRole
  status      MembershipStatus @default(active)
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  business Business @relation(fields: [business_id], references: [id], onDelete: Restrict)

  @@unique([user_id, business_id])
  @@index([business_id, status])
  @@map("UserMembership")
}

/// Append-only audit trail (FR-10). There is no update or delete path:
/// lib/data/audit.ts exposes writes only.
model AuditLog {
  id          String      @id @default(cuid())
  business_id String
  user_id     String
  action      AuditAction
  target_type String
  target_id   String
  /// Only the fields that changed, not the whole record (conventions.md §6).
  old_value   Json?
  new_value   Json?
  created_at  DateTime    @default(now())

  business Business @relation(fields: [business_id], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([business_id, created_at(sort: Desc)])
  @@index([target_type, target_id])
  @@map("AuditLog")
}

// ---------------------------------------------------------------------------
// Stage 02 — customers
// ---------------------------------------------------------------------------

/// A regular or one-off advertiser (US-002).
///
/// Deliberately has no company registration number: that field appeared in the
/// Stitch mockups but is not in the ERD (docs/design/gaps.md §א).
model Customer {
  id            String       @id @default(cuid())
  business_id   String
  customer_type CustomerType
  /// Required for `regular`, optional for `casual` — enforced in the domain layer.
  business_name String?
  contact_name  String
  /// At least one of phone/email is required, enforced by a CHECK constraint.
  phone         String?
  email         String?
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  business       Business        @relation(fields: [business_id], references: [id], onDelete: Restrict)
  ad_orders      AdOrder[]
  publications   Publication[]
  /// Restrict: a customer with files on record is not something to delete out
  /// from under them (stage 05 §מודל נתונים).
  advertisements Advertisement[]
  reminders      Reminder[]

  @@index([business_id, contact_name])
  @@index([business_id, business_name])
  @@index([business_id, customer_type])
  @@map("Customer")
}

// ---------------------------------------------------------------------------
// Stage 03 — newspaper configuration, page grid, ad shapes and pricing
// ---------------------------------------------------------------------------

/// Where on the page a shape may sit (US-006 AC-4).
enum OrderSource {
  internal
  customer_portal
}

enum OrderStatus {
  draft
  pending_approval
  approved
  rejected
  canceled
  completed
}

enum PaymentStatus {
  unpaid
  partially_paid
  paid
  debt
}

/// The eight publication states from conventions.md §3.
enum PublicationStatus {
  planned
  missing_ad
  ad_received
  ready_for_layout
  placed
  published
  canceled
  billed
}

/// Derived field: `placed` exactly while an active Placement exists.
enum PlacementStatus {
  not_placed
  placed
}

enum ShapePosition {
  anywhere
  region
}

/// A newspaper published by a business (US-006, FR-21).
model Newspaper {
  id               String   @id @default(cuid())
  business_id      String
  name             String
  /// One of the sizes in lib/domain/page-size.ts, or "custom".
  page_size        String
  /// Millimetres. Free-form print quality text, per the ERD — deliberately not
  /// a dpi picker: dpi/CMYK/bleed were Stitch inventions (design/gaps.md §א).
  margin           Decimal  @db.Decimal(6, 2)
  print_quality    String
  logo_url         String?
  fixed_banner_url String?
  /// Bytes. The single source of truth for the upload limit (FR-21) — there is
  /// no hard-coded size anywhere in the code.
  max_ad_file_size Int
  /// Only set when page_size = "custom". Millimetres.
  custom_width_mm  Decimal? @db.Decimal(7, 2)
  custom_height_mm Decimal? @db.Decimal(7, 2)

  /// --- Page grid (US-006 AC-4) ---------------------------------------------
  /// The page is divided into `columns` columns of derived width and rows of
  /// `row_height_mm`. The ROW COUNT AND COLUMN WIDTH ARE NEVER STORED: they are
  /// derived from the page size in lib/domain/grid.ts, so changing page_size or
  /// margin can never leave a stale, contradictory number in the database.
  columns       Int
  /// Millimetres, one grid row.
  row_height_mm Decimal @db.Decimal(6, 2)
  /// Millimetres. Applied between adjacent cells AND between the outermost
  /// cells and the frame, so it appears (columns + 1) times across the width.
  gutter_mm     Decimal @default(0) @db.Decimal(6, 2)

  /// --- Print schedule -------------------------------------------------------
  /// Which weekdays this newspaper is printed on, as JS `getDay()` numbers
  /// (0 = Sunday … 6 = Saturday). An EMPTY ARRAY means "no schedule declared",
  /// which is not the same as "never prints": with no schedule the order
  /// builder simply has nothing to check a date against and stays quiet.
  /// Deliberately a weekday list and not a rule engine — an irregular run
  /// (every other week, holiday eves only) is expressed by the dates the user
  /// ticks on the order, not by a recurrence stored here.
  publication_days Int[] @default([])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  business     Business      @relation(fields: [business_id], references: [id], onDelete: Restrict)
  page_types   PageType[]
  ad_shapes    AdShape[]
  price_rules  PriceRule[]
  order_items  AdOrderItem[]
  publications Publication[]
  issues       Issue[]

  @@unique([business_id, name])
  @@index([business_id])
  @@map("Newspaper")
}

/// Cover, back, inner, premium… free text, not an enum (US-006).
model PageType {
  id           String   @id @default(cuid())
  newspaper_id String
  name         String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  newspaper      Newspaper        @relation(fields: [newspaper_id], references: [id], onDelete: Cascade)
  allowed_shapes AllowedAdShape[]
  price_rules    PriceRule[]
  order_items    AdOrderItem[]
  issue_pages    IssuePage[]

  @@unique([newspaper_id, name])
  /// Target for the composite foreign keys below. `id` alone is already unique;
  /// this pair exists so a child row must name the newspaper it belongs to.
  @@unique([id, newspaper_id])
  @@index([newspaper_id])
  @@map("PageType")
}

/// A rectangular ad shape, measured in GRID UNITS of its newspaper's page
/// division (US-006 AC-4).
///
/// Owned by the newspaper: the six base shapes in lib/domain/base-shapes.ts are
/// copied in when a newspaper is created, and the newspaper edits, deletes and
/// adds to them freely. Until 24/08/2026 this model was global — the one
/// documented exception to tenant scoping — and the reversal is recorded in
/// conventions.md §2. Tying the shape to the newspaper is what makes `cols` and
/// `rows` meaningful: they are only ever read against one grid.
model AdShape {
  id            String        @id @default(cuid())
  newspaper_id  String
  name          String
  /// Footprint in grid cells. Rectangular only — no L-shapes in the MVP.
  cols          Int
  rows          Int
  position_mode ShapePosition @default(anywhere)
  /// null when position_mode = anywhere. Otherwise { cells: [[col, row], …] }:
  /// the set that every cell of the shape's footprint must fall inside.
  allowed_cells Json?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  newspaper    Newspaper        @relation(fields: [newspaper_id], references: [id], onDelete: Cascade)
  allowed_on   AllowedAdShape[]
  price_rules  PriceRule[]
  order_items  AdOrderItem[]
  publications Publication[]
  placements   Placement[]

  @@unique([newspaper_id, name])
  /// Target for the composite foreign keys below — see PageType.
  @@unique([id, newspaper_id])
  @@index([newspaper_id])
  @@map("AdShape")
}

/// Which shapes may be placed on a given page type (FR-14).
///
/// Both foreign keys carry `newspaper_id`, so a row pairing one newspaper's
/// page type with another's shape is not merely rejected — it cannot be
/// represented. Tenant safety here does not depend on anyone remembering
/// (conventions.md §2).
model AllowedAdShape {
  id           String   @id @default(cuid())
  newspaper_id String
  page_type_id String
  ad_shape_id  String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  page_type PageType @relation(fields: [page_type_id, newspaper_id], references: [id, newspaper_id], onDelete: Cascade)
  /// Cascade, not Restrict: the Restrict existed to protect TemplateSlot, which
  /// is gone, and the shapes now belong to the user. Deleting a shape takes its
  /// permissions with it.
  ad_shape  AdShape  @relation(fields: [ad_shape_id, newspaper_id], references: [id, newspaper_id], onDelete: Cascade)

  @@unique([page_type_id, ad_shape_id])
  @@index([newspaper_id])
  @@map("AllowedAdShape")
}

/// Base price per (newspaper, page type, shape). Copied onto the publication at
/// order approval and never read again — conventions.md §7, FR-17.
model PriceRule {
  id           String   @id @default(cuid())
  newspaper_id String
  page_type_id String
  ad_shape_id  String
  price        Decimal  @db.Decimal(12, 2)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  newspaper Newspaper @relation(fields: [newspaper_id], references: [id], onDelete: Cascade)
  page_type PageType  @relation(fields: [page_type_id, newspaper_id], references: [id, newspaper_id], onDelete: Cascade)
  /// Cascade is safe here precisely because of conventions.md §7 rule 1: a
  /// PriceRule is only ever a default at order-creation time and
  /// Publication.price is a copy, so deleting a shape cannot rewrite money that
  /// has already been agreed.
  ad_shape  AdShape   @relation(fields: [ad_shape_id, newspaper_id], references: [id, newspaper_id], onDelete: Cascade)

  @@unique([newspaper_id, page_type_id, ad_shape_id])
  @@index([newspaper_id])
  @@map("PriceRule")
}

// ---------------------------------------------------------------------------
// Stage 04 — orders and publications
// ---------------------------------------------------------------------------

/// A sales order. Nothing binding exists until it is approved: a draft creates
/// no publications at all (US-003 AC-5).
model AdOrder {
  id                      String        @id @default(cuid())
  business_id             String
  customer_id             String
  source                  OrderSource   @default(internal)
  status                  OrderStatus   @default(draft)
  /// Optional (FR-19). When present it is shown to the customer in the portal.
  rejection_reason        String?
  /// Sum of the line prices. Computed on the server only, never trusted from
  /// the client. A single total — no VAT and no commissions, which were Stitch
  /// inventions (docs/design/gaps.md §א).
  total_price             Decimal       @default(0) @db.Decimal(12, 2)
  payment_status          PaymentStatus @default(unpaid)
  external_invoice_number String?
  /// The artwork for this whole order, when it arrived WITH the order.
  ///
  /// Not in docs/erd.md, and added because the common case in practice is one
  /// file for every date: the customer sends a single advertisement and asks
  /// for it to run several times. Without this the file has nowhere to live
  /// while the order is still a draft — publications do not exist yet — so it
  /// had to be parked in the library and attached by hand to every publication
  /// after approval. On approval each publication created is linked to it, and
  /// each one can still be changed individually afterwards.
  advertisement_id        String?
  approved_at             DateTime?
  completed_at            DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  business      Business       @relation(fields: [business_id], references: [id], onDelete: Restrict)
  customer      Customer       @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  /// SetNull for the same reason as on Publication: losing the file must not
  /// lose the order.
  advertisement Advertisement? @relation(fields: [advertisement_id], references: [id], onDelete: SetNull)
  items         AdOrderItem[]
  publications  Publication[]

  @@index([business_id, status])
  @@index([business_id, customer_id, created_at])
  @@map("AdOrder")
}

/// One planned publication inside an order.
///
/// `page_type_id` is not in the ERD but is required: PriceRule is keyed by
/// (newspaper, page_type, ad_shape), so without it no price can be derived.
/// Documented as an implementation addition in docs/plan/04-orders-publications.md.
model AdOrderItem {
  id               String   @id @default(cuid())
  order_id         String
  newspaper_id     String
  page_type_id     String
  ad_shape_id      String
  publication_date DateTime @db.Date
  /// Taken from PriceRule as a default, overridable by hand. Once the order is
  /// approved this value is copied onto the Publication and frozen (FR-17).
  price            Decimal  @db.Decimal(12, 2)
  /// Set when the user knowingly ordered a date that is not one of the
  /// newspaper's `publication_days` — a special edition. Stored rather than
  /// re-derived so that later changing the newspaper's schedule cannot
  /// retroactively turn a deliberate choice into a warning.
  off_schedule     Boolean  @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  order       AdOrder      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  newspaper   Newspaper    @relation(fields: [newspaper_id], references: [id], onDelete: Restrict)
  /// Composite keys, per conventions.md §2: a row that crosses one newspaper's
  /// page type with another newspaper's shape is not representable.
  page_type   PageType     @relation(fields: [page_type_id, newspaper_id], references: [id, newspaper_id], onDelete: Restrict)
  ad_shape    AdShape      @relation(fields: [ad_shape_id, newspaper_id], references: [id, newspaper_id], onDelete: Restrict)
  publication Publication?

  @@index([order_id])
  @@map("AdOrderItem")
}

/// A binding publication. Created only on order approval, one per order item.
model Publication {
  id               String            @id @default(cuid())
  business_id      String
  order_id         String
  /// Unique: this is what makes approval idempotent — a double click cannot
  /// produce duplicate publications.
  order_item_id    String?           @unique
  customer_id      String
  newspaper_id     String
  ad_shape_id      String
  advertisement_id String?
  publication_date DateTime          @db.Date
  /// Copied from AdOrderItem at approval and never read from PriceRule again
  /// (FR-17, conventions.md §7).
  price            Decimal           @db.Decimal(12, 2)
  source           OrderSource
  status           PublicationStatus @default(planned)
  placement_status PlacementStatus   @default(not_placed)
  payment_status   PaymentStatus     @default(unpaid)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  business      Business       @relation(fields: [business_id], references: [id], onDelete: Restrict)
  order         AdOrder        @relation(fields: [order_id], references: [id], onDelete: Restrict)
  order_item    AdOrderItem?   @relation(fields: [order_item_id], references: [id], onDelete: SetNull)
  customer      Customer       @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  newspaper     Newspaper      @relation(fields: [newspaper_id], references: [id], onDelete: Restrict)
  ad_shape      AdShape        @relation(fields: [ad_shape_id, newspaper_id], references: [id, newspaper_id], onDelete: Restrict)
  /// SetNull, not Cascade: losing the file must not lose the publication. The
  /// publication stands, with no ad, and the state machine walks it back to
  /// `missing_ad` (stage 05 §מודל נתונים).
  advertisement Advertisement? @relation(fields: [advertisement_id], references: [id], onDelete: SetNull)
  reminder      Reminder?
  placements    Placement[]

  @@index([business_id, publication_date, status])
  @@index([business_id, newspaper_id, publication_date])
  @@index([business_id, customer_id])
  @@index([advertisement_id])
  @@map("Publication")
}

// ---------------------------------------------------------------------------
// Stage 05 — advertisement files
// ---------------------------------------------------------------------------

/// The three formats US-005 allows. Decided by MAGIC BYTES, never by the file
/// name: an extension is something the uploader typed, not something the file
/// is.
enum AdFileType {
  pdf
  jpg
  png
}

/// `archived` is how an ad leaves the library. There is no delete: an ad that
/// already ran in an issue is evidence, and the Publication that used it keeps
/// pointing at it.
enum AdStatus {
  valid
  invalid
  archived
}

enum AdValidationStatus {
  pending
  passed
  failed
}

/// An uploaded advertisement file (US-005, FR-15, FR-21).
///
/// Deliberately has no newspaper_id: an ad is a file belonging to a CUSTOMER,
/// and the same file may run in several newspapers. A newspaper is picked at
/// upload time only to decide WHICH max_ad_file_size to enforce (FR-21), and
/// that choice is not worth storing — re-checking it later would re-litigate a
/// limit that has since changed.
///
/// Deliberately has no "notes to the designer" field either: it appears in the
/// Stitch mockup and in neither prd.md nor erd.md (docs/design/gaps.md §א).
model Advertisement {
  id                  String             @id @default(cuid())
  business_id         String
  /// Optional in the schema, but an ad without a customer is NOT placeable
  /// (US-005 AC-4) — enforced in the domain layer and shown as a badge.
  customer_id         String?
  uploaded_by_user_id String
  name                String
  file_type           AdFileType
  /// Bytes, as stored. Checked against Newspaper.max_ad_file_size (FR-21);
  /// there is no hard-coded ceiling anywhere in the code.
  file_size           Int
  /// --- Object keys, never public URLs (conventions.md §5) ------------------
  /// The live file — the one that goes into the PDF.
  file_url            String
  /// The first upload. NEVER overwritten, not even by a third replacement
  /// (US-005 AC-3).
  original_file_url   String
  /// Exactly one previous version is kept (US-005 AC-5). A further replacement
  /// overwrites this, and the one it overwrote is gone.
  previous_file_url   String?
  /// PNG, generated on upload "where possible".
  preview_url         String?
  status              AdStatus           @default(valid)
  validation_status   AdValidationStatus @default(pending)
  /// Hebrew, shown verbatim on the card. Null while the file is valid.
  validation_error    String?
  uploaded_at         DateTime           @default(now())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  business     Business      @relation(fields: [business_id], references: [id], onDelete: Restrict)
  customer     Customer?     @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  uploaded_by  User          @relation(fields: [uploaded_by_user_id], references: [id], onDelete: Restrict)
  publications Publication[]
  ad_orders    AdOrder[]
  placements   Placement[]

  @@index([business_id, customer_id])
  @@index([business_id, status, validation_status])
  @@index([business_id, uploaded_at(sort: Desc)])
  @@map("Advertisement")
}

// ---------------------------------------------------------------------------
// Stage 06 — issues and the placement board
// ---------------------------------------------------------------------------

/// FR-6. `closed` blocks every write to the issue, its pages and the
/// publications on it; walking back out of it is admin-only and audited.
enum IssueStatus {
  draft
  in_layout
  ready_for_print
  closed
}

/// A placement's own lifecycle.
///
/// Removing is a status change and never a DELETE: the row is the record of
/// what a designer did, and — just as importantly — the two constraints that
/// implement FR-16 are PARTIAL indexes filtered on `placed`. A removed row
/// leaves the space free without leaving the history empty.
enum PlacementState {
  placed
  removed
  published
}

/// One dated issue of one newspaper (US-007, FR-6).
///
/// The grid columns below are a SNAPSHOT of the newspaper's page division,
/// copied once when the issue is opened and never read from `Newspaper` again
/// (conventions.md §7 rule 2). Editing the newspaper afterwards must not move a
/// single ad in an issue that has already been laid out. The row count and the
/// column width stay derived — lib/domain/grid.ts computes them from this
/// snapshot exactly as it does from the live settings, so there is one formula
/// and not two.
model Issue {
  id            String      @id @default(cuid())
  business_id   String
  newspaper_id  String
  issue_date    DateTime    @db.Date
  status        IssueStatus @default(draft)
  /// Written at close (stage 07). Object key, never a public URL.
  final_pdf_url String?
  closed_at     DateTime?

  /// --- The grid snapshot ----------------------------------------------------
  page_size        String
  custom_width_mm  Decimal? @db.Decimal(7, 2)
  custom_height_mm Decimal? @db.Decimal(7, 2)
  margin           Decimal  @db.Decimal(6, 2)
  columns          Int
  row_height_mm    Decimal  @db.Decimal(6, 2)
  gutter_mm        Decimal  @default(0) @db.Decimal(6, 2)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  business   Business    @relation(fields: [business_id], references: [id], onDelete: Restrict)
  newspaper  Newspaper   @relation(fields: [newspaper_id], references: [id], onDelete: Restrict)
  pages      IssuePage[]
  placements Placement[]

  /// One issue per newspaper per day.
  @@unique([business_id, newspaper_id, issue_date])
  @@index([business_id, status, issue_date])
  @@map("Issue")
}

/// A single numbered page of an issue, of one page type.
///
/// Deliberately a single page and not a spread: `page_number` is one integer,
/// and a double truck ("page 2-3") is out of scope (docs/design/gaps.md §א).
model IssuePage {
  id           String   @id @default(cuid())
  issue_id     String
  page_type_id String
  page_number  Int
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  issue      Issue       @relation(fields: [issue_id], references: [id], onDelete: Cascade)
  /// Restrict: a page type in use by an issue is not something the settings
  /// screen may delete out from under it.
  page_type  PageType    @relation(fields: [page_type_id], references: [id], onDelete: Restrict)
  placements Placement[]

  @@unique([issue_id, page_number])
  /// Target for Placement's composite foreign key — this is what makes
  /// Placement.issue_id provably the page's own issue rather than a copy
  /// someone has to remember to keep in step (conventions.md §4).
  @@unique([id, issue_id])
  @@index([issue_id])
  @@map("IssuePage")
}

/// One ad placed on one page, as a rectangle of grid cells (FR-14, FR-16).
///
/// `col`/`row`/`cols`/`rows` are stored HERE and read from here at print time.
/// `cols`/`rows` are copied from the shape at placement, so editing the
/// catalogue later cannot resize an ad that has already been laid out
/// (conventions.md §7). `col = 0` is the RIGHT edge of the page — the RTL rule
/// at the top of lib/domain/slot-geometry.ts.
///
/// `issue_id` is denormalised from the page on purpose: without it the partial
/// unique index that stops one publication being placed twice in an issue
/// cannot be expressed at all (conventions.md §4).
model Placement {
  id               String @id @default(cuid())
  issue_id         String
  issue_page_id    String
  publication_id   String
  advertisement_id String
  ad_shape_id      String

  col  Int
  row  Int
  cols Int
  rows Int

  status                                 PlacementState @default(placed)
  /// FR-16. Admin-only, audited, and the exact flag the partial unique index
  /// filters on — approving the override is what makes the second row legal.
  duplicate_override_approved            Boolean        @default(false)
  duplicate_override_approved_by_user_id String?
  duplicate_override_approved_at         DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  issue         Issue         @relation(fields: [issue_id], references: [id], onDelete: Cascade)
  page          IssuePage     @relation(fields: [issue_page_id, issue_id], references: [id, issue_id], onDelete: Cascade)
  publication   Publication   @relation(fields: [publication_id], references: [id], onDelete: Restrict)
  advertisement Advertisement @relation(fields: [advertisement_id], references: [id], onDelete: Restrict)
  /// Restrict: a shape that has been printed is evidence. Deleting it from the
  /// catalogue would leave a placement describing a size nobody can name.
  ad_shape      AdShape       @relation(fields: [ad_shape_id], references: [id], onDelete: Restrict)
  approved_by   User?         @relation(fields: [duplicate_override_approved_by_user_id], references: [id], onDelete: SetNull)

  @@index([issue_page_id, status])
  @@index([publication_id])
  @@index([issue_id, status])
  @@map("Placement")
}

// ---------------------------------------------------------------------------
// Stage 10 (brought forward) — reminders
// ---------------------------------------------------------------------------
//
// The reminder half of stage 10 is delivered here rather than at the end,
// because it depends only on Publication and Advertisement — both of which
// exist — while the dashboard half also needs Issue and Payment, which do not.
// Waiting would have meant the most common operational failure in this
// business, "the customer ordered and never sent artwork", stays invisible
// until the very last stage.

/// FR-11. `needed` is computed, the rest are marks a person makes.
///
/// There is deliberately no state that means "the system sent it": nothing is
/// sent automatically in the MVP, and a status implying otherwise would be a
/// lie the screen then has to apologise for.
enum ReminderStatus {
  needed
  approved_to_send
  sent
  failed
}

/// One publication that is close to its date and still has no artwork (FR-11).
model Reminder {
  id             String         @id @default(cuid())
  publication_id String
  customer_id    String
  status         ReminderStatus @default(needed)
  sent_at        DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  publication Publication @relation(fields: [publication_id], references: [id], onDelete: Cascade)
  customer    Customer    @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  /// One live reminder per publication — chasing the same customer twice for
  /// the same slot is how a reminder list stops being trusted.
  @@unique([publication_id])
  @@index([customer_id, status])
  @@map("Reminder")
}
